<Window x:Class="UniSound.UI.LocalImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Завантаження локальної музики" Height="330" Width="500"
        WindowStartupLocation="CenterOwner" Background="#1E1B2E" Foreground="White"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Завантажити трек з комп'ютера" FontSize="18" FontWeight="Bold" Foreground="#E0D7FF" Margin="0,0,0,15"/>

        <!-- Файл -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBox x:Name="txtFilePath" Width="330" Height="32" Padding="8,5" IsReadOnly="True" 
                     Background="#2A2640" Foreground="White" BorderBrush="#4A4270"/>
            <Button x:Name="btnBrowse" Content="Огляд..." Width="110" Height="32" Margin="10,0,0,0" 
                    Background="#6C5CE7" Foreground="White" FontWeight="Bold" Click="BtnBrowse_Click"/>
        </StackPanel>

        <!-- Назва -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Назва треку:" Foreground="#B8B3D3" Margin="0,0,0,5"/>
            <TextBox x:Name="txtTitle" Height="30" Padding="5" Background="#2A2640" Foreground="White" BorderBrush="#4A4270"/>
        </StackPanel>

        <!-- Виконавець -->
        <StackPanel Grid.Row="3" Margin="0,0,0,15">
            <TextBlock Text="Виконавець:" Foreground="#B8B3D3" Margin="0,0,0,5"/>
            <TextBox x:Name="txtArtist" Height="30" Padding="5" Background="#2A2640" Foreground="White" BorderBrush="#4A4270"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Скасувати" Width="100" Height="35" Margin="0,0,10,0" Background="#3D375A" Foreground="White" Click="BtnCancel_Click"/>
            <Button x:Name="btnAdd" Content="☁️ Додати в Drive" Width="160" Height="35" Background="#00B894" Foreground="White" FontWeight="Bold" Click="BtnAdd_Click"/>
        </StackPanel>
    </Grid>
</Window>