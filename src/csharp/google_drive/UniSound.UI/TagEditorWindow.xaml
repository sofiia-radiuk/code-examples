<Window x:Class="UniSound.UI.TagEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UniSound - Редактор метаданих треку" Height="420" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#12091A" Foreground="White">
    <Grid Margin="25">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Редагування ID3-тегів" FontSize="20" FontWeight="Bold" Foreground="#C084FC" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Назва треку (Title):" Margin="0,5,0,2" Foreground="#A08CB6" FontSize="12"/>
            <TextBox x:Name="txtTitle" Height="28" Padding="5,2" Background="#2A173B" Foreground="White" BorderThickness="1" BorderBrush="#3D2359"/>

            <TextBlock Text="Виконавець (Artist):" Margin="0,10,0,2" Foreground="#A08CB6" FontSize="12"/>
            <TextBox x:Name="txtArtist" Height="28" Padding="5,2" Background="#2A173B" Foreground="White" BorderThickness="1" BorderBrush="#3D2359"/>

            <TextBlock Text="Альбом (Album):" Margin="0,10,0,2" Foreground="#A08CB6" FontSize="12"/>
            <TextBox x:Name="txtAlbum" Height="28" Padding="5,2" Background="#2A173B" Foreground="White" BorderThickness="1" BorderBrush="#3D2359"/>

            <TextBlock Text="Жанр (Genre):" Margin="0,10,0,2" Foreground="#A08CB6" FontSize="12"/>
            <ComboBox x:Name="cmbGenre" Height="28" Background="#2A173B" Foreground="Black">
                <ComboBoxItem Content="Rock" IsSelected="True"/>
                <ComboBoxItem Content="Pop"/>
                <ComboBoxItem Content="Electronic"/>
                <ComboBoxItem Content="Hip-Hop"/>
                <ComboBoxItem Content="Jazz"/>
                <ComboBoxItem Content="Classical"/>
            </ComboBox>

            <Button x:Name="btnSaveTags" Content="💾 Зберегти зміни в Drive" Height="36" Margin="0,25,0,0" 
                    Background="#9D4EDD" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="btnSaveTags_Click"/>
        </StackPanel>
    </Grid>
</Window>